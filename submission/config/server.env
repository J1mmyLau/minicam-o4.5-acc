# server.env — 冻结候选启动环境（run 基线，勿改冻结参数）
# 来源：T6 harness（scripts/f6_phase3_t6_integrated_regression.py）SERVER_ENV
# 统一路径变量：REPO_ROOT（由脚本在 source 前设置）/
#   MODEL_PATH（必填，无私有默认）/ DATA_ROOT / DEMO_DIR / OUTPUT_ROOT / OFFICIAL_HARNESS_ROOT。

# --- 版本口径（不得改；LLAMA_CANDIDATE_SOURCE_COMMIT = 参赛冻结源码） ---
LLAMA_CANDIDATE_SOURCE_COMMIT="${LLAMA_CANDIDATE_SOURCE_COMMIT:-bdd4550}"

# --- 路径（可覆盖；禁止私有绝对路径作为默认值；默认一律从 REPO_ROOT 派生） ---
# MODEL_PATH：MiniCPM-o-4_5 GGUF 路径（模型 SHA d1e69845…）。必填，无默认；脚本显式校验。
MODEL_PATH="${MODEL_PATH:-}"
# SERVER_BIN：冻结 server 二进制（candidate 默认 build/bin；baseline 用 BASELINE_SERVER_BIN）
SERVER_BIN="${SERVER_BIN:-${REPO_ROOT}/build/bin/llama-omni-server}"
# SERVER_PORT：服务端口
SERVER_PORT="${SERVER_PORT:-18093}"
# 数据根目录（三 Benchmark 的父目录；默认为仓库同级的 benchmarks，可显式覆盖）
DATA_ROOT="${DATA_ROOT:-${REPO_ROOT}/../benchmarks}"
# 官方 Demo 前端目录（默认为仓库内 third_party，可显式覆盖）
DEMO_DIR="${DEMO_DIR:-${REPO_ROOT}/third_party/MiniCPM-o-Demo}"
# 评测输出根目录（默认 ${REPO_ROOT}/submission_runs，绝不用 /tmp）
OUTPUT_ROOT="${OUTPUT_ROOT:-${REPO_ROOT}/submission_runs}"
# 官方 Harness / Starter Kit 目录（到达前可不存在，脚本应 fail-fast 而非默认路径）
OFFICIAL_HARNESS_ROOT="${OFFICIAL_HARNESS_ROOT:-${REPO_ROOT}/../llama.cpp-omni-official-eval/competition}"

# --- 冻结推理参数（不得修改） ---
NGL="${NGL:-999}"
DEVICE="${DEVICE:-CANN0}"
CTX="${CTX:-4096}"
BATCH="${BATCH:-512}"
UBATCH="${UBATCH:-512}"
SPLIT_MODE="${SPLIT_MODE:-layer}"

# --- 冻结候选环境变量（不得修改） ---
OMNI_KV_CACHE_REUSE="${OMNI_KV_CACHE_REUSE:-1}"
# KV cache 路径：默认在 results/<run_id>/ 下，不用 /tmp（可覆盖）
OMNI_KV_CACHE_PATH="${OMNI_KV_CACHE_PATH:-}"
OMNI_T2W_DEVICE="${OMNI_T2W_DEVICE:-cann-flow-only}"
OMNI_VOC_DEVICE="${OMNI_VOC_DEVICE:-gpu}"
ASCEND_RT_VISIBLE_DEVICES="${ASCEND_RT_VISIBLE_DEVICES:-0}"
