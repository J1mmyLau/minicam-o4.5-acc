# config-accuracy.env — 精度任务（videomme / daily-omni / tts）专用环境
# 用法: EVAL_CONFIG="$PWD/config-accuracy.env" ./evaluation/run_eval.sh <task>
# ⚠ GM3M9G: perf env（TL kernels/OP_FUSION/ACL_GRAPH/VPM）只在 RTS 链路做过位级验证，
#   在 64 帧/29.9k-token 长上下文 prefill 上系统性污染 logits。精度任务必须全量关闭。

# --- 精度任务 perf env 全量显式关闭（GM3M9G 修复核心）---
OMNI_TL_QKR=0
OMNI_TL_NORM=0
OMNI_TL_TTS=0
OMNI_TL_CONV=0
OMNI_VPM_PAR=0
OMNI_VPM_PATCHMM=0
GGML_CANN_OPERATOR_FUSION=0
GGML_CANN_ACL_GRAPH=off
GGML_CANN_WEIGHT_NZ=off

# --- A+C 杠杆在精度任务中的处置 ---
# OMNI_DUPLEX_MAX_SLICE / OMNI_TTS_FIRST_CHUNK_STEP 不设（评测 CLI 走默认值 128/5），
# 精度任务与性能任务的视觉 token 预算解耦。

# --- 稳定性基线（Config D 继承，精度链路同样需要）---
OMNI_CANN_FA_MAX_UBATCH=32
OMNI_T2W_DEVICE=cann-flow-only
OMNI_VOC_DEVICE=gpu:0
OMNI_T2W_PIPELINE_OVERLAP=1

# --- NFE5（匹配 shipped prompt_cache.gguf；NFE2 只用于 RTS）---
OMNI_T2W_N_TIMESTEPS=5

# --- 其余路径/模型/采样参数见仓库根 config-local.env（同版本管理）---
