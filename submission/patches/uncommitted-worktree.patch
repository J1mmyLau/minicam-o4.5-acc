+static void talker_fill_batch_row(llama_batch & batch, int row, int pos, int seq_id,
+                                  const float * embedding) {
+    std::memcpy(batch.embd + (size_t) row * TALKER_N_EMBD,
+                embedding, TALKER_N_EMBD * sizeof(float));
+    batch.pos[row] = pos;
+    batch.n_seq_id[row] = 1;
+    batch.seq_id[row][0] = seq_id;
+    batch.logits[row] = 1;
+}
