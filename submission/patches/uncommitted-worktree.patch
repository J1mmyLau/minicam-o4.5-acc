+static bool talker_tensor_to_f32(const ggml_tensor * tensor, std::vector<float> & output, std::string & error) {
+    const int64_t count = ggml_nelements(tensor);
+    if (count <= 0) {
+        error = "empty tensor: " + std::string(tensor->name);
+        return false;
+    }
+    output.resize((size_t) count);
+    if (tensor->type == GGML_TYPE_F32) {
+        std::memcpy(output.data(), tensor->data, output.size() * sizeof(float));
+    } else {
+        const auto * traits = ggml_get_type_traits(tensor->type);
+        if (!traits || !traits->to_float) {
+            error = "missing F32 converter for tensor: " + std::string(tensor->name);
+            return false;
+        }
+        traits->to_float(tensor->data, output.data(), count);
+    }
+    if (!talker_all_finite(output.data(), output.size())) {
+        error = "non-finite values in tensor: " + std::string(tensor->name);
+        return false;
+    }
+    return true;
+}
