+                llama_free(ctx);
+                return false;
+            }
+            if (mismatch >= 0) {
+                error = "unexpected oracle mismatch at trace token " + std::to_string(start + mismatch) +
+                        " (lane " + std::to_string(mismatch_lane) +
+                        ", block offset " + std::to_string(mismatch) +
+                        ", predicted=" + std::to_string(first_predicted) +
+                        ", first_proposal=" + std::to_string(first_proposal) + ")";
+                llama_free(ctx);
+                return false;
+            }
+            const float * expected_hidden = trace.hidden.data() +
+                (size_t) (start + block_len) * TALKER_N_EMBD;
+            for (int lane = 0; lane < lanes; ++lane) {
+                float max_abs = 0.0f;
+                float max_rel = 0.0f;
+                if (!talker_hidden_matches(lane_hidden.data() + (size_t) lane * TALKER_N_EMBD,
+                                           expected_hidden, max_abs, max_rel)) {
+                    error = "block hidden-state mismatch at trace token " +
+                            std::to_string(start + block_len - 1) +
+                            " (max_abs=" + std::to_string(max_abs) +
+                            ", max_rel=" + std::to_string(max_rel) + ")";
