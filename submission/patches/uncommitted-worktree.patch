+static bool talker_save_lane_state(llama_context * ctx, int lanes,
+                                   std::vector<std::vector<uint8_t>> & states,
+                                   std::string & error) {
+    states.resize(lanes);
+    for (int lane = 0; lane < lanes; ++lane) {
+        const size_t size = llama_state_seq_get_size(ctx, lane);
+        if (size == 0) {
+            error = "failed to size talker sequence state";
+            return false;
+        }
+        states[lane].resize(size);
+        if (llama_state_seq_get_data(ctx, states[lane].data(), size, lane) != size) {
+            error = "failed to snapshot complete talker sequence state";
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool talker_restore_lane_states(llama_context * ctx,
+                                       const std::vector<std::vector<uint8_t>> & states,
+                                       std::string & error) {
+    llama_memory_clear(llama_get_memory(ctx), false);
+    for (int lane = 0; lane < (int) states.size(); ++lane) {
+        const auto & state = states[lane];
+        if (llama_state_seq_set_data(ctx, state.data(), state.size(), lane) != state.size()) {
+            error = "failed to restore complete talker sequence state";
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool talker_decode_block(llama_context * ctx,
+                                const talker_verify_weights & weights,
+                                const talker_oracle_trace & trace,
+                                int lanes,
+                                int start,
+                                int block_len,
+                                std::vector<float> & lane_hidden,
+                                std::vector<float> & logits,
+                                talker_bench_sample & sample,
+                                int injected_offset,
+                                int & mismatch_offset,
+                                int * mismatch_lane_out,
+                                int * first_predicted,
+                                int * first_proposal,
+                                std::string & error) {
+    const auto t_pack0 = talker_clock::now();
+    llama_batch batch = llama_batch_init(lanes * block_len, TALKER_N_EMBD, 1);
+    batch.n_tokens = lanes * block_len;
+    int row = 0;
+    for (int lane = 0; lane < lanes; ++lane) {
+        for (int j = 0; j < block_len; ++j, ++row) {
+            int token = trace.tokens[start + j];
+            if (lane == 0 && j == injected_offset) {
+                token = (token + 1) % TALKER_AUDIO_EOS;
+            }
+            talker_fill_batch_row(batch, row, trace.condition_rows + start + j, lane,
+                                  weights.emb_code.data() + (size_t) token * TALKER_N_EMBD);
+        }
+    }
+    sample.pack_ms += std::chrono::duration<double, std::milli>(talker_clock::now() - t_pack0).count();
+
+    const auto t_decode0 = talker_clock::now();
+    const int decode_rc = llama_decode(ctx, batch);
+    llama_synchronize(ctx);
+    sample.decode_ms += std::chrono::duration<double, std::milli>(talker_clock::now() - t_decode0).count();
+    if (decode_rc != 0) {
+        error = "block llama_decode failed: " + std::to_string(decode_rc);
+        llama_batch_free(batch);
+        return false;
+    }
+
+    const auto t_hidden0 = talker_clock::now();
+    std::vector<float> rows((size_t) lanes * block_len * TALKER_N_EMBD);
+    for (int i = 0; i < lanes * block_len; ++i) {
+        const float * hidden = llama_get_embeddings_ith(ctx, i);
+        if (!hidden || !talker_all_finite(hidden, TALKER_N_EMBD)) {
+            error = "block returned invalid hidden state";
+            llama_batch_free(batch);
+            return false;
+        }
+        std::memcpy(rows.data() + (size_t) i * TALKER_N_EMBD,
+                    hidden, TALKER_N_EMBD * sizeof(float));
+    }
+    sample.hidden_ms += std::chrono::duration<double, std::milli>(talker_clock::now() - t_hidden0).count();
+
+    const auto t_head0 = talker_clock::now();
+    mismatch_offset = -1;
+    int mismatch_lane = -1;
+    for (int lane = 0; lane < lanes; ++lane) {
+        for (int j = 0; j < block_len; ++j) {
+            const float * predictor = j == 0
+                ? lane_hidden.data() + (size_t) lane * TALKER_N_EMBD
+                : rows.data() + ((size_t) lane * block_len + j - 1) * TALKER_N_EMBD;
+            int predicted = -1;
+            float margin = 0.0f;
+            if (!talker_head_argmax(weights, predictor, logits, predicted, margin, error)) {
+                llama_batch_free(batch);
+                return false;
+            }
+            int proposal = trace.tokens[start + j];
+            if (lane == 0 && j == injected_offset) {
+                proposal = (proposal + 1) % TALKER_AUDIO_EOS;
+            }
+            if (lane == 0 && j == 0) {
+                if (first_predicted) {
+                    *first_predicted = predicted;
+                }
+                if (first_proposal) {
+                    *first_proposal = proposal;
+                }
+            }
+            if (predicted != proposal && mismatch_offset < 0) {
+                mismatch_offset = j;
+                mismatch_lane = lane;
+                if (first_predicted) {
+                    *first_predicted = predicted;
+                }
+                if (first_proposal) {
+                    *first_proposal = proposal;
+                }
+            }
+        }
+        std::memcpy(lane_hidden.data() + (size_t) lane * TALKER_N_EMBD,
+                    rows.data() + ((size_t) lane * block_len + block_len - 1) * TALKER_N_EMBD,
+                    TALKER_N_EMBD * sizeof(float));
+    }
+    if (mismatch_lane_out) {
+        *mismatch_lane_out = mismatch_lane;
+    }
+    sample.head_ms += std::chrono::duration<double, std::milli>(talker_clock::now() - t_head0).count();
+    sample.verified_tokens += lanes * block_len;
+    ++sample.blocks;
+    llama_batch_free(batch);
+    return true;
+}
+
+static bool talker_hidden_matches(const float * actual, const float * expected,
+                                  float & max_abs, float & max_rel) {
+    max_abs = 0.0f;
+    max_rel = 0.0f;
+    for (int i = 0; i < TALKER_N_EMBD; ++i) {
+        const float abs_diff = std::fabs(actual[i] - expected[i]);
+        const float rel_diff = abs_diff / std::max(1e-6f, std::fabs(expected[i]));
+        max_abs = std::max(max_abs, abs_diff);
+        max_rel = std::max(max_rel, rel_diff);
+    }
+    // CANN can differ by a few millithirds across equivalent sequence layouts;
+    // promotion is decided by the exact external head token, while this guards
+    // against a materially different hidden trajectory.
+    return max_abs <= 1e-2f;
+}
