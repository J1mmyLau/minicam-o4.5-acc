+bool runner_checked_i64_product(int64_t a, int64_t b, int64_t & product) {
+    if (a <= 0 || b <= 0 || a > std::numeric_limits<int64_t>::max() / b) {
+        return false;
+    }
+    product = a * b;
+    return true;
+}
+bool runner_checked_element_count(std::initializer_list<int64_t> dims, size_t & count) {
+    count = 1;
+    for (const int64_t dim : dims) {
+        if (dim <= 0 || count > SIZE_MAX / (size_t) dim) {
+            return false;
+        }
+        count *= (size_t) dim;
+    }
+    return true;
+}
+bool runner_checked_f32_byte_count(std::initializer_list<int64_t> dims, size_t & bytes) {
+    size_t elements = 0;
+    if (!runner_checked_element_count(dims, elements) || elements > SIZE_MAX / sizeof(float)) {
+        return false;
+    }
+    bytes = elements * sizeof(float);
+    return true;
+}
