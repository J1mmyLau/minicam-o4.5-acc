+static bool talker_load_weights(const std::string & model_path, talker_verify_weights & weights, std::string & error) {
+    ggml_context * ctx_meta = nullptr;
+    gguf_init_params params = { false, &ctx_meta };
+    gguf_context * gguf = gguf_init_from_file(model_path.c_str(), params);
+    if (!gguf || !ctx_meta) {
+        error = "failed to open talker GGUF: " + model_path;
+        if (gguf) {
+            gguf_free(gguf);
+        }
+        if (ctx_meta) {
+            ggml_free(ctx_meta);
+        }
+        return false;
+    }
+
+    auto finish = [&]() {
+        ggml_free(ctx_meta);
+        gguf_free(gguf);
+    };
+    auto find_tensor = [&](const char * name) -> ggml_tensor * {
+        if (gguf_find_tensor(gguf, name) < 0) {
+            return nullptr;
+        }
+        return ggml_get_tensor(ctx_meta, name);
+    };
+
+    ggml_tensor * emb_code = find_tensor("emb_code.0.weight");
+    ggml_tensor * emb_text = find_tensor("emb_text.weight");
+    ggml_tensor * head_code = find_tensor("head_code.0.weight");
+    if (!emb_code || !emb_text || !head_code) {
+        error = "talker GGUF is missing emb_code, emb_text, or head_code";
+        finish();
+        return false;
+    }
+
+    if (emb_code->ne[0] != TALKER_N_EMBD || emb_code->ne[1] != TALKER_AUDIO_VOCAB) {
+        error = "unexpected emb_code shape";
+        finish();
+        return false;
+    }
+    if (emb_text->ne[0] != TALKER_N_EMBD || emb_text->ne[1] <= TALKER_TEXT_EOS_TOKEN) {
+        error = "unexpected emb_text shape";
+        finish();
+        return false;
+    }
+    if (!((head_code->ne[0] == TALKER_AUDIO_VOCAB && head_code->ne[1] == TALKER_N_EMBD) ||
+          (head_code->ne[0] == TALKER_N_EMBD && head_code->ne[1] == TALKER_AUDIO_VOCAB))) {
+        error = "unexpected head_code shape";
+        finish();
+        return false;
+    }
+
+    if (!talker_tensor_to_f32(emb_code, weights.emb_code, error) ||
+        !talker_tensor_to_f32(emb_text, weights.emb_text, error)) {
+        finish();
+        return false;
+    }
+
+    std::vector<float> head_raw;
+    if (!talker_tensor_to_f32(head_code, head_raw, error)) {
+        finish();
+        return false;
+    }
+    weights.head_code.resize((size_t) TALKER_AUDIO_VOCAB * TALKER_N_EMBD);
+
+    // This conversion is the production layout contract: the conversion script
+    // stores head_code as hidden-major [768][6562], while GGUF reports the
+    // inverse logical shape. Normalize once to token-major [6562][768].
+    for (int token = 0; token < TALKER_AUDIO_VOCAB; ++token) {
+        for (int hidden = 0; hidden < TALKER_N_EMBD; ++hidden) {
+            weights.head_code[(size_t) token * TALKER_N_EMBD + hidden] =
+                head_raw[(size_t) hidden * TALKER_AUDIO_VOCAB + token];
+        }
+    }
+    finish();
+    return true;
+}
