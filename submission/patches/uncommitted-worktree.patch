+    static_assert(sizeof(bits) == sizeof(value), "float must be 32-bit");
+    std::memcpy(&bits, &value, sizeof(bits));
+    talker_rollout_append_u32(out, bits);
+}
+
+static void talker_rollout_append_magic(std::vector<uint8_t> & out, const char magic[8]) {
+    out.insert(out.end(), magic, magic + 8);
+}
+
+static void talker_rollout_append_header(std::vector<uint8_t> & out,
+                                         const char magic[8],
+                                         uint32_t record_size,
+                                         uint64_t record_count) {
+    talker_rollout_append_magic(out, magic);
+    talker_rollout_append_u16(out, 1);
+    talker_rollout_append_u16(out, 0);
+    talker_rollout_append_u32(out, record_size);
+    talker_rollout_append_u64(out, record_count);
+    talker_rollout_append_u64(out, 0);
+}
+
+static void talker_rollout_remove_tmp_files(const std::string & dir);
+
+static void talker_rollout_disable(struct omni_context * ctx_omni, const std::string & reason) {
+    TalkerRolloutState & state = ctx_omni->talker_rollout;
+    if (!state.enabled) {
+        return;
+    }
+    if (!state.active_tmp_dir.empty()) {
+        talker_rollout_remove_tmp_files(state.active_tmp_dir);
+    }
+    state.capture_failed = true;
+    state.active = false;
+    state.candidate_count = 0;
+    state.conditions.clear();
+    state.condition_records.clear();
+    state.steps.clear();
+    state.active_tmp_dir.clear();
+    state.active_final_dir.clear();
+    state.end_reason = reason;
+    LOG_ERR("Talker rollout capture disabled: %s\n", reason.c_str());
+}
+
+static bool talker_rollout_write_file(const std::string & path,
+                                      const std::vector<uint8_t> & data,
+                                      uint32_t * crc_out) {
+    FILE * file = fopen(path.c_str(), "wb");
+    if (!file) {
+        return false;
+    }
+    bool ok = data.empty() || fwrite(data.data(), 1, data.size(), file) == data.size();
+    ok = ok && fflush(file) == 0;
+#ifndef _WIN32
+    ok = ok && fsync(fileno(file)) == 0;
+#endif
+    if (fclose(file) != 0) {
+        ok = false;
+    }
+    if (!ok) {
+        unlink(path.c_str());
+        return false;
+    }
+    if (crc_out) {
+        *crc_out = kv_cache_crc32(data.data(), data.size());
+    }
+    return true;
+}
+
+static bool talker_rollout_fsync_parent(const std::string & path) {
+#ifndef _WIN32
+    const size_t slash = path.find_last_of('/');
+    const std::string parent = slash == std::string::npos ? "." : path.substr(0, slash);
+    const int fd = open(parent.c_str(), O_RDONLY | O_DIRECTORY);
+    if (fd < 0) {
+        return false;
+    }
+    const bool ok = fsync(fd) == 0;
+    close(fd);
+    return ok;
+#else
+    (void) path;
+    return true;
+#endif
+}
+
+static void talker_rollout_initialize(struct omni_context * ctx_omni) {
+    TalkerRolloutState & state = ctx_omni->talker_rollout;
+    const char * root = getenv("OMNI_TALKER_ROLLOUT_DIR");
+    if (!root || root[0] == '\0' || !ctx_omni->use_tts) {
+        return;
+    }
+    state.enabled = true;
+    state.root_dir = root;
+    state.media_type = ctx_omni->media_type;
+    state.duplex_mode = ctx_omni->duplex_mode;
+    if (!talker_rollout_host_little_endian()) {
+        talker_rollout_disable(ctx_omni, "rollout capture currently requires a little-endian host");
+        return;
+    }
+    if (!cross_platform_mkdir_p(state.root_dir)) {
+        talker_rollout_disable(ctx_omni, "failed to create rollout root directory");
+        return;
+    }
+    print_with_timestamp("Talker rollout capture ENABLED: %s\n", state.root_dir.c_str());
+}
+
+static void talker_rollout_reset_sequence(TalkerRolloutState & state) {
+    state.active = false;
+    state.finalized = false;
+    state.sequence_id = 0;
+    state.next_condition_id = 1;
+    state.next_global_step = 0;
+    state.current_condition_id = 0;
+    state.current_chunk_id = 0;
+    state.candidate_count = 0;
+    state.active_tmp_dir.clear();
+    state.active_final_dir.clear();
+    state.end_reason.clear();
+    state.conditions.clear();
+    state.condition_records.clear();
+    state.steps.clear();
+}
+
+static bool talker_rollout_finalize(struct omni_context * ctx_omni,
+                                    const std::string & reason,
+                                    bool complete);
+
+static bool talker_rollout_begin(struct omni_context * ctx_omni,
+                                  uint32_t request_generation,
+                                  int turn_id) {
+    TalkerRolloutState & state = ctx_omni->talker_rollout;
+    if (!state.enabled || state.capture_failed) {
+        return false;
+    }
+    if (state.active) {
+        if (!talker_rollout_finalize(ctx_omni, "superseded_by_new_sequence", false)) {
+            return false;
+        }
+    }
+    talker_rollout_reset_sequence(state);
+    state.active = true;
+    state.request_generation = request_generation;
+    state.turn_id = turn_id;
+    state.media_type = ctx_omni->media_type;
+    state.duplex_mode = ctx_omni->duplex_mode;
+    for (uint32_t attempt = 0; attempt < 1000000; ++attempt) {
+        state.sequence_id = state.next_sequence_id++;
+        char name[128];
+        snprintf(name, sizeof(name), "sequence_%08llu_g%u_t%d",
+                 (unsigned long long) state.sequence_id,
+                 state.request_generation,
+                 state.turn_id);
+        state.active_final_dir = state.root_dir + "/" + name;
+        state.active_tmp_dir = state.active_final_dir + ".tmp";
+        struct stat final_stat;
+        struct stat tmp_stat;
+        if (stat(state.active_final_dir.c_str(), &final_stat) == 0 ||
+            stat(state.active_tmp_dir.c_str(), &tmp_stat) == 0) {
+            continue;
+        }
+        if (cross_platform_mkdir_p(state.active_tmp_dir)) {
+            return true;
+        }
+        break;
+    }
+    talker_rollout_disable(ctx_omni, "failed to create unique sequence directory");
+    return false;
+}
+
+static uint64_t talker_rollout_rng_digest(const std::mt19937 & rng) {
+    std::ostringstream stream;
+    stream << rng;
+    return kv_cache_fnv1a_str(stream.str());
+}
+
+static bool talker_rollout_register_condition(struct omni_context * ctx_omni,
+                                              const std::vector<float> & rows,
+                                              uint32_t text_row_count,
+                                              uint8_t text_eos_count,
+                                              uint8_t audio_bos_count,
+                                              uint32_t request_generation,
+                                              int32_t turn_id,
+                                              uint32_t chunk_id,
+                                              int32_t src_cnt_min,
+                                              int32_t src_cnt_max,
+                                              int32_t prefill_base_position,
+                                              bool is_end_of_turn) {
+    TalkerRolloutState & state = ctx_omni->talker_rollout;
+    if (!state.enabled || state.capture_failed) {
+        return false;
+    }
+    // Sequence identity is the TURN: request_generation increments per WS
+    // message (per chunk) in the duplex server, so it is metadata, not a
+    // sequence key. state.request_generation keeps the first-seen value for
+    // the manifest.
+    if (state.active && turn_id != state.turn_id) {
+        if (!talker_rollout_finalize(ctx_omni, "turn_changed", false)) {
+            return false;
+        }
+    } else if (state.active && chunk_id == 0) {
+        if (!talker_rollout_finalize(ctx_omni, "unexpected_chunk_zero", false)) {
+            return false;
+        }
+    }
+    if (!state.active && !talker_rollout_begin(ctx_omni, request_generation, turn_id)) {
+        return false;
+    }
+    if (rows.size() % 768 != 0) {
+        talker_rollout_disable(ctx_omni, "canonical condition width is not 768");
+        return false;
+    }
+    const size_t row_count_value = rows.size() / 768;
+    if (row_count_value > TALKER_ROLLOUT_MAX_CONDITION_ROWS ||
+        state.conditions.size() / 768 > TALKER_ROLLOUT_MAX_CONDITION_ROWS - row_count_value) {
+        talker_rollout_disable(ctx_omni, "canonical condition rows exceed sequence limit");
+        return false;
+    }
+    const uint32_t row_count = (uint32_t) row_count_value;
+    if (row_count != text_row_count + text_eos_count + audio_bos_count || audio_bos_count != 1) {
+        talker_rollout_disable(ctx_omni, "invalid canonical condition suffix counts");
+        return false;
+    }
+    TalkerRolloutCondition condition;
+    condition.condition_id = state.next_condition_id++;
+    condition.chunk_id = chunk_id;
+    condition.src_cnt_min = src_cnt_min;
+    condition.src_cnt_max = src_cnt_max;
+    condition.prefill_base_position = prefill_base_position;
+    condition.row_offset = state.conditions.size() / 768;
+    condition.text_row_count = text_row_count;
+    condition.row_count = row_count;
+    condition.text_eos_count = text_eos_count;
+    condition.audio_bos_count = audio_bos_count;
+    condition.is_end_of_turn = is_end_of_turn;
+    if (text_eos_count == 1) {
+        const size_t offset = (size_t) text_row_count * 768;
+        condition.text_eos_row_crc32 = kv_cache_crc32(rows.data() + offset, 768 * sizeof(float));
+    }
+    const size_t bos_offset = (size_t) (row_count - 1) * 768;
+    condition.audio_bos_row_crc32 = kv_cache_crc32(rows.data() + bos_offset, 768 * sizeof(float));
+    state.conditions.insert(state.conditions.end(), rows.begin(), rows.end());
+    state.condition_records.push_back(condition);
+    state.current_condition_id = condition.condition_id;
+    state.current_chunk_id = chunk_id;
+    return true;
+}
+
+static void talker_rollout_commit_step(struct omni_context * ctx_omni, TalkerRolloutStep && step) {
+    TalkerRolloutState & state = ctx_omni->talker_rollout;
+    if (!state.enabled || !state.active || state.capture_failed) {
+        return;
+    }
+    if (step.hidden.size() != 768 || (step.has_feedback && step.feedback.size() != 768) ||
+        (!step.has_feedback && !step.feedback.empty())) {
+        talker_rollout_disable(ctx_omni, "invalid per-step tensor width");
+        return;
+    }
+    if (state.current_condition_id == 0 ||
+        state.steps.size() >= TALKER_ROLLOUT_MAX_STEPS ||
+        step.top_candidates.size() > TALKER_ROLLOUT_MAX_CANDIDATES_PER_STEP ||
+        state.candidate_count > UINT64_MAX - step.top_candidates.size()) {
+        talker_rollout_disable(ctx_omni, "per-step rollout limits exceeded");
+        return;
+    }
+    step.condition_id = state.current_condition_id;
+    step.chunk_id = state.current_chunk_id;
+    step.global_step = state.next_global_step++;
+    step.candidate_offset = state.candidate_count;
+    state.candidate_count += step.top_candidates.size();
+    state.steps.push_back(std::move(step));
+}
+
+static void talker_rollout_capture_candidates(
+    TalkerRolloutStep & step,
+    const float * processed_logits,
+    const std::vector<int> & retained_indices,
+    int raw_top1_code,
+    int selected_code,
+    int eos_code,
+    bool eos_masked,
+    float eos_logit_processed_before_mask) {
+    auto find_candidate = [&step](int code) -> TalkerRolloutTopCandidate * {
+        for (auto & candidate : step.top_candidates) {
+            if (candidate.code == code) {
+                return &candidate;
+            }
+        }
+        return nullptr;
+    };
+    auto add_candidate = [&](int code, uint32_t flags) {
+        TalkerRolloutTopCandidate * existing = find_candidate(code);
+        if (existing != nullptr) {
+            existing->flags |= flags;
+            return;
+        }
+        if (step.top_candidates.size() >= TALKER_ROLLOUT_MAX_CANDIDATES_PER_STEP) {
+            return;
+        }
+        TalkerRolloutTopCandidate candidate;
+        candidate.code = code;
+        candidate.processed_logit =
+            eos_masked && code == eos_code ? eos_logit_processed_before_mask : processed_logits[code];
+        candidate.flags = flags;
+        step.top_candidates.push_back(candidate);
+    };
+
+    for (int code : retained_indices) {
+        add_candidate(code, TALKER_ROLLOUT_CANDIDATE_RETAINED);
+    }
+    add_candidate(raw_top1_code, TALKER_ROLLOUT_CANDIDATE_RAW_TOP1);
+    add_candidate(selected_code, TALKER_ROLLOUT_CANDIDATE_SELECTED);
+    add_candidate(eos_code,
+                  TALKER_ROLLOUT_CANDIDATE_EOS |
+                      (eos_masked ? TALKER_ROLLOUT_CANDIDATE_MASKED
+                                  : static_cast<uint32_t>(0)));
+}
+
+static void talker_rollout_append_condition_record(std::vector<uint8_t> & out,
+                                                   const TalkerRolloutCondition & condition) {
+    talker_rollout_append_u64(out, condition.condition_id);
+    talker_rollout_append_u32(out, condition.chunk_id);
+    talker_rollout_append_i32(out, condition.src_cnt_min);
+    talker_rollout_append_i32(out, condition.src_cnt_max);
+    talker_rollout_append_i32(out, condition.prefill_base_position);
+    talker_rollout_append_u64(out, condition.row_offset);
+    talker_rollout_append_u32(out, condition.text_row_count);
+    talker_rollout_append_u32(out, condition.row_count);
+    talker_rollout_append_u32(out, condition.text_eos_row_crc32);
+    talker_rollout_append_u32(out, condition.audio_bos_row_crc32);
+    out.push_back(condition.text_eos_count);
+    out.push_back(condition.audio_bos_count);
+    out.push_back(condition.is_end_of_turn ? 1 : 0);
+    out.push_back(0);
+    talker_rollout_append_u64(out, 0);
+    talker_rollout_append_u32(out, 0);
+}
+
+static void talker_rollout_append_step_record(std::vector<uint8_t> & out,
+                                              const TalkerRolloutStep & step) {
+    talker_rollout_append_u64(out, step.condition_id);
+    talker_rollout_append_u64(out, step.global_step);
+    talker_rollout_append_u32(out, step.chunk_id);
+    talker_rollout_append_u32(out, step.chunk_step);
+    talker_rollout_append_i32(out, step.decision_position);
+    talker_rollout_append_i32(out, step.n_past_before_feedback);
+    talker_rollout_append_i32(out, step.n_past_after_feedback);
+    talker_rollout_append_i32(out, step.previous_code);
+    talker_rollout_append_i32(out, step.selected_code);
+    talker_rollout_append_i32(out, step.selected_token_id);
+    talker_rollout_append_i32(out, step.raw_top1_code);
+    talker_rollout_append_u64(out, step.candidate_offset);
+    uint32_t flags = 0;
+    flags |= step.first_overall ? 1u << 0 : 0;
+    flags |= step.condition_reforwarded ? 1u << 1 : 0;
+    flags |= step.force_no_eos ? 1u << 2 : 0;
+    flags |= step.skip_processors ? 1u << 3 : 0;
+    flags |= step.use_argmax ? 1u << 4 : 0;
+    flags |= step.is_eos ? 1u << 5 : 0;
+    flags |= step.has_feedback ? 1u << 6 : 0;
+    talker_rollout_append_u32(out, flags);
+    talker_rollout_append_u32(out, (uint32_t) step.top_candidates.size());
+    talker_rollout_append_u64(out, step.rng_state_digest);
+    talker_rollout_append_u64(out, 0);
+}
+
+static void talker_rollout_remove_tmp_files(const std::string & dir) {
+    if (dir.empty()) {
+        return;
+    }
+    static const char * names[] = {
+        "conditions.bin", "steps.bin", "hidden.f32",
+        "feedback.f32", "candidates.bin", "manifest.json",
+    };
+    for (const char * name : names) {
+        unlink((dir + "/" + name).c_str());
+    }
+#ifndef _WIN32
+    rmdir(dir.c_str());
+#endif
+}
+
+static bool talker_rollout_fail_publication(struct omni_context * ctx_omni,
+                                            const std::string & reason) {
+    talker_rollout_disable(ctx_omni, reason);
+    return false;
+}
+
+static bool talker_rollout_finalize(struct omni_context * ctx_omni,
+                                    const std::string & reason,
+                                    bool complete) {
+    TalkerRolloutState & state = ctx_omni->talker_rollout;
+    if (!state.enabled || !state.active || state.capture_failed) {
+        return false;
+    }
+    // Idempotency guard: the defensive turn_state_reset after a successful
+    // turn_complete must not overwrite the published manifest. After the
+    // first finalize the sequence is already on disk; a second call for the
+    // same sequence is a no-op (the caller's "flushed without a clean
+    // boundary" assumption is simply stale).
+    if (state.finalized) {
+        return true;
+    }
+    state.finalized = true;
+    state.end_reason = reason;
+    const uint64_t condition_row_count = state.conditions.size() / 768;
+    if (state.conditions.size() % 768 != 0 ||
+        condition_row_count > TALKER_ROLLOUT_MAX_CONDITION_ROWS ||
+        state.steps.size() > TALKER_ROLLOUT_MAX_STEPS ||
+        state.candidate_count > state.steps.size() * TALKER_ROLLOUT_MAX_CANDIDATES_PER_STEP) {
+        return talker_rollout_fail_publication(ctx_omni, "rollout sequence exceeds serialization limits");
+    }
+    const uint64_t estimated_bytes =
+        5ULL * TALKER_ROLLOUT_HEADER_BYTES +
+        state.condition_records.size() * TALKER_ROLLOUT_CONDITION_RECORD_BYTES +
+        condition_row_count * TALKER_ROLLOUT_TENSOR_ROW_BYTES +
+        state.steps.size() *
+            (TALKER_ROLLOUT_STEP_RECORD_BYTES + 2ULL * TALKER_ROLLOUT_TENSOR_ROW_BYTES) +
+        state.candidate_count * TALKER_ROLLOUT_CANDIDATE_RECORD_BYTES;
+    if (estimated_bytes > TALKER_ROLLOUT_MAX_SEQUENCE_BYTES) {
+        return talker_rollout_fail_publication(ctx_omni, "rollout sequence exceeds byte limit");
+    }
+
+    std::vector<uint8_t> conditions;
+    talker_rollout_append_header(conditions, "OMTLCND1",
+                                 TALKER_ROLLOUT_CONDITION_RECORD_BYTES,
+                                 state.condition_records.size());
+    for (const auto & condition : state.condition_records) {
+        talker_rollout_append_condition_record(conditions, condition);
+    }
+    for (float value : state.conditions) {
+        talker_rollout_append_f32(conditions, value);
+    }
+    std::vector<uint8_t> steps;
+    talker_rollout_append_header(steps, "OMTLSTP1",
+                                 TALKER_ROLLOUT_STEP_RECORD_BYTES,
+                                 state.steps.size());
+    for (const auto & step : state.steps) {
+        talker_rollout_append_step_record(steps, step);
+    }
+    std::vector<uint8_t> hidden;
+    talker_rollout_append_header(hidden, "OMTLHID1",
+                                 TALKER_ROLLOUT_TENSOR_ROW_BYTES,
+                                 state.steps.size());
+    std::vector<uint8_t> feedback;
+    talker_rollout_append_header(feedback, "OMTLFDB1",
+                                 TALKER_ROLLOUT_TENSOR_ROW_BYTES,
+                                 state.steps.size());
+    std::vector<uint8_t> candidates;
+    uint64_t candidate_count = 0;
+    for (const auto & step : state.steps) {
+        candidate_count += step.top_candidates.size();
+        for (float value : step.hidden) {
+            talker_rollout_append_f32(hidden, value);
+        }
+        if (step.has_feedback) {
+            for (float value : step.feedback) {
+                talker_rollout_append_f32(feedback, value);
+            }
+        } else {
+            for (uint32_t i = 0; i < 768; ++i) {
+                talker_rollout_append_f32(feedback, 0.0f);
+            }
+        }
+    }
+    if (candidate_count != state.candidate_count) {
+        return talker_rollout_fail_publication(ctx_omni, "candidate accounting mismatch");
+    }
+    talker_rollout_append_header(candidates, "OMTLCAN1",
+                                 TALKER_ROLLOUT_CANDIDATE_RECORD_BYTES,
+                                 candidate_count);
+    for (const auto & step : state.steps) {
+        for (const auto & candidate : step.top_candidates) {
+            talker_rollout_append_i32(candidates, candidate.code);
+            talker_rollout_append_f32(candidates, candidate.processed_logit);
+            talker_rollout_append_u32(candidates, candidate.flags);
+        }
+    }
+    struct rollout_file {
+        const char * name;
+        const std::vector<uint8_t> * bytes;
+        uint64_t count;
+        uint32_t crc = 0;
+    };
+    std::vector<rollout_file> files = {
+        {"conditions.bin", &conditions, state.condition_records.size()},
+        {"steps.bin", &steps, state.steps.size()},
+        {"hidden.f32", &hidden, state.steps.size()},
+        {"feedback.f32", &feedback, state.steps.size()},
+        {"candidates.bin", &candidates, candidate_count},
+    };
+    for (auto & file : files) {
+        if (!talker_rollout_write_file(state.active_tmp_dir + "/" + file.name,
+                                       *file.bytes, &file.crc)) {
+            return talker_rollout_fail_publication(
+                ctx_omni, std::string("failed to write ") + file.name);
+        }
+    }
+    nlohmann::json manifest = {
+        {"schema", "omni.talker_rollout.v1"},
+        {"endianness", "little"},
+        {"complete", complete},
+        {"end_reason", reason},
+        {"sequence_id", state.sequence_id},
+        {"request_generation", state.request_generation},
+        {"turn_id", state.turn_id},
+        {"media_type", state.media_type},
+        {"duplex_mode", state.duplex_mode},
+        {"hidden_width", 768},
+        {"audio_vocab", 6562},
+        {"audio_bos_token_id", 151687},
+        {"audio_eos_code", 6561},
+        {"condition_count", state.condition_records.size()},
+        {"condition_row_count", condition_row_count},
+        {"step_count", state.steps.size()},
+        {"candidate_count", candidate_count},
+        {"record_layout", {
+            {"header_bytes", TALKER_ROLLOUT_HEADER_BYTES},
+            {"condition_record_bytes", TALKER_ROLLOUT_CONDITION_RECORD_BYTES},
+            {"step_record_bytes", TALKER_ROLLOUT_STEP_RECORD_BYTES},
+            {"tensor_row_bytes", TALKER_ROLLOUT_TENSOR_ROW_BYTES},
+            {"candidate_record_bytes", TALKER_ROLLOUT_CANDIDATE_RECORD_BYTES},
+            {"condition_row_offset_units", "rows"},
+        }},
+        {"candidate_flags", {
+            {"raw_top1", TALKER_ROLLOUT_CANDIDATE_RAW_TOP1},
+            {"selected", TALKER_ROLLOUT_CANDIDATE_SELECTED},
+            {"eos", TALKER_ROLLOUT_CANDIDATE_EOS},
+            {"retained", TALKER_ROLLOUT_CANDIDATE_RETAINED},
