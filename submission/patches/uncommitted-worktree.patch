+static bool talker_create_context(llama_model * model,
+                                  const omni_talker_verify_config & config,
+                                  int lanes,
+                                  llama_context ** out,
+                                  std::string & error) {
+    llama_context_params params = llama_context_default_params();
+    params.n_ctx = (uint32_t) config.n_ctx;
+    params.n_batch = (uint32_t) std::max(config.n_batch, lanes * config.block_tokens);
+    params.n_ubatch = (uint32_t) std::max(config.n_ubatch, lanes * config.block_tokens);
+    params.n_seq_max = (uint32_t) lanes;
+    params.kv_unified = lanes > 1;
+    params.n_threads = config.n_threads;
+    params.n_threads_batch = config.n_threads;
+    params.embeddings = true;
+    params.offload_kqv = true;
+    *out = llama_init_from_model(model, params);
+    if (!*out) {
+        error = "failed to create talker verifier context";
+        return false;
+    }
+    llama_set_embeddings(*out, true);
+    return true;
+}
+
+static bool talker_build_oracle(llama_model * model,
+                                const omni_talker_verify_config & config,
+                                const talker_verify_weights & weights,
+                                const talker_verify_fixture & fixture,
+                                talker_oracle_trace & trace,
+                                std::string & error) {
+    llama_context * ctx = nullptr;
+    if (!talker_create_context(model, config, 1, &ctx, error)) {
+        return false;
+    }
+    std::vector<float> current;
+    double prefill_ms = 0.0;
+    if (!talker_prefill_context(ctx, fixture, 1, current, prefill_ms, error)) {
+        llama_free(ctx);
+        return false;
+    }
+    trace.condition_rows = fixture.n_rows;
+    trace.hidden.insert(trace.hidden.end(), current.begin(), current.end());
+    std::vector<float> logits(TALKER_AUDIO_VOCAB);
+
+    for (int i = 0; i < config.max_audio_tokens; ++i) {
+        int token = -1;
+        float margin = 0.0f;
+        if (!talker_head_argmax(weights, current.data(), logits, token, margin, error)) {
+            llama_free(ctx);
+            return false;
+        }
+        trace.tokens.push_back(token);
+        trace.margins.push_back(margin);
+        trace.digest ^= (uint32_t) token;
+        trace.digest *= 1099511628211ULL;
+        if (token == TALKER_AUDIO_EOS) {
+            break;
+        }
+
+        llama_batch batch = llama_batch_init(1, TALKER_N_EMBD, 1);
+        batch.n_tokens = 1;
+        talker_fill_batch_row(batch, 0, fixture.n_rows + i, 0,
+                              weights.emb_code.data() + (size_t) token * TALKER_N_EMBD);
+        const int decode_rc = llama_decode(ctx, batch);
+        llama_synchronize(ctx);
+        if (decode_rc != 0) {
+            error = "oracle llama_decode failed: " + std::to_string(decode_rc);
+            llama_batch_free(batch);
+            llama_free(ctx);
+            return false;
+        }
+        const float * hidden = llama_get_embeddings_ith(ctx, 0);
+        if (!hidden || !talker_all_finite(hidden, TALKER_N_EMBD)) {
+            error = "oracle returned invalid hidden state";
+            llama_batch_free(batch);
+            llama_free(ctx);
+            return false;
+        }
+        current.assign(hidden, hidden + TALKER_N_EMBD);
+        trace.hidden.insert(trace.hidden.end(), current.begin(), current.end());
+        llama_batch_free(batch);
+    }
+    llama_free(ctx);
+    if (trace.tokens.empty()) {
+        error = "oracle produced no audio tokens";
