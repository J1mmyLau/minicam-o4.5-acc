+static bool talker_read_fixture(const omni_talker_verify_config & config,
+                                const talker_verify_weights & weights,
+                                talker_verify_fixture & fixture,
+                                std::string & error) {
+    std::ifstream in(config.fixture_path, std::ios::binary | std::ios::ate);
+    if (!in) {
+        error = "failed to open condition fixture: " + config.fixture_path;
+        return false;
+    }
+    const std::streamsize size = in.tellg();
+    if (size < (std::streamsize) (2 * sizeof(int32_t))) {
+        error = "condition fixture is too small";
+        return false;
+    }
+    in.seekg(0, std::ios::beg);
+    int32_t header[2] = {};
+    if (!in.read(reinterpret_cast<char *>(header), sizeof(header))) {
+        error = "failed to read condition fixture header";
+        return false;
+    }
+    fixture.n_rows = header[0];
+    fixture.n_embd = header[1];
+    if (fixture.n_rows <= 0 || fixture.n_rows > 10000 || fixture.n_embd != TALKER_N_EMBD) {
+        error = "invalid condition fixture dimensions";
+        return false;
+    }
+    const size_t payload_count = (size_t) fixture.n_rows * fixture.n_embd;
+    const size_t expected_size = sizeof(header) + payload_count * sizeof(float);
+    if ((size_t) size != expected_size) {
+        error = "condition fixture size does not match its header";
+        return false;
+    }
+    fixture.rows.resize(payload_count);
+    if (!in.read(reinterpret_cast<char *>(fixture.rows.data()), payload_count * sizeof(float))) {
+        error = "failed to read condition fixture payload";
+        return false;
+    }
+    if (!talker_all_finite(fixture.rows.data(), fixture.rows.size())) {
+        error = "condition fixture contains non-finite values";
+        return false;
+    }
+
+    auto append_text_embedding = [&](int token_id) {
+        const float * row = weights.emb_text.data() + (size_t) token_id * TALKER_N_EMBD;
+        fixture.rows.insert(fixture.rows.end(), row, row + TALKER_N_EMBD);
+        ++fixture.n_rows;
+    };
+
+    if (config.fixture_mode == "legacy-suffix") {
+        if (config.text_eos_mode == "present") {
+            append_text_embedding(TALKER_TEXT_EOS_TOKEN);
+            fixture.text_eos_reconstructed = true;
+        } else if (config.text_eos_mode != "absent") {
+            error = "legacy fixture requires --talker-text-eos present|absent";
+            return false;
+        }
+        append_text_embedding(TALKER_AUDIO_BOS_TOKEN);
+        fixture.audio_bos_reconstructed = true;
+    } else if (config.fixture_mode == "complete") {
+        const float * expected = weights.emb_text.data() + (size_t) TALKER_AUDIO_BOS_TOKEN * TALKER_N_EMBD;
+        const float * actual = fixture.rows.data() + (size_t) (fixture.n_rows - 1) * TALKER_N_EMBD;
+        if (std::memcmp(expected, actual, TALKER_N_EMBD * sizeof(float)) != 0) {
+            error = "complete fixture does not end with the exact audio-BOS embedding";
+            return false;
+        }
+    } else {
+        error = "invalid fixture mode: " + config.fixture_mode;
+        return false;
+    }
+    return true;
+}
+
+static bool talker_head_argmax(const talker_verify_weights & weights,
+                               const float * hidden,
+                               std::vector<float> & logits,
+                               int & token,
+                               float & margin,
+                               std::string & error) {
+    // Use the same host head as the production path for a realistic upper
+    // bound. Oracle and verifier call this exact helper, so their reduction
+    // order remains identical within one run.
+    if (logits.size() != TALKER_AUDIO_VOCAB) {
+        error = "invalid talker head scratch size";
+        return false;
+    }
+    head_code_gemv(weights.head_code.data(), hidden, logits.data(), TALKER_AUDIO_VOCAB, TALKER_N_EMBD);
+
+    int best = 0;
+    int second = 1;
+    float best_logit = logits[best];
+    float second_logit = logits[second];
+    if (second_logit > best_logit) {
+        std::swap(best, second);
+        std::swap(best_logit, second_logit);
+    }
+    for (int i = 2; i < TALKER_AUDIO_VOCAB; ++i) {
+        const float value = logits[i];
+        if (!std::isfinite(value)) {
+            error = "non-finite talker head logit";
+            return false;
+        }
+        if (value > best_logit) {
+            second = best;
+            second_logit = best_logit;
+            best = i;
+            best_logit = value;
+        } else if (value > second_logit) {
+            second = i;
+            second_logit = value;
+        }
+    }
+    if (!std::isfinite(best_logit) || !std::isfinite(second_logit)) {
+        error = "non-finite talker head maximum";
+        return false;
+    }
+    token = best;
+    margin = best_logit - second_logit;
+    return true;
+}
