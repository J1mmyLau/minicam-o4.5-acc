+static bool talker_prefill_context(llama_context * ctx,
+                                   const talker_verify_fixture & fixture,
+                                   int lanes,
+                                   std::vector<float> & last_hidden,
+                                   double & elapsed_ms,
+                                   std::string & error) {
+    llama_memory_clear(llama_get_memory(ctx), false);
+    // Evaluate the common condition once and copy its KV state to every lane.
+    // Decoding identical prompt rows for several sequence IDs in one batch is
+    // not a supported shared-prefix construction for all cache backends.
+    const int total = fixture.n_rows;
+    llama_batch batch = llama_batch_init(total, TALKER_N_EMBD, 1);
+    batch.n_tokens = total;
+    for (int pos = 0; pos < fixture.n_rows; ++pos) {
+        talker_fill_batch_row(batch, pos, pos, 0,
+                              fixture.rows.data() + (size_t) pos * TALKER_N_EMBD);
+    }
+    const auto t0 = talker_clock::now();
+    const int decode_rc = llama_decode(ctx, batch);
+    llama_synchronize(ctx);
+    elapsed_ms = std::chrono::duration<double, std::milli>(talker_clock::now() - t0).count();
+    if (decode_rc != 0) {
+        error = "condition prefill llama_decode failed: " + std::to_string(decode_rc);
+        llama_batch_free(batch);
+        return false;
+    }
+    const float * hidden = llama_get_embeddings_ith(ctx, fixture.n_rows - 1);
+    if (!hidden || !talker_all_finite(hidden, TALKER_N_EMBD)) {
+        error = "failed to read finite condition hidden state";
+        llama_batch_free(batch);
+        return false;
+    }
+    last_hidden.resize((size_t) lanes * TALKER_N_EMBD);
+    for (int lane = 0; lane < lanes; ++lane) {
+        std::memcpy(last_hidden.data() + (size_t) lane * TALKER_N_EMBD,
+                    hidden, TALKER_N_EMBD * sizeof(float));
+    }
+    llama_memory_t memory = llama_get_memory(ctx);
+    for (int lane = 1; lane < lanes; ++lane) {
+        llama_memory_seq_cp(memory, 0, lane, 0, fixture.n_rows);
+    }
+    llama_batch_free(batch);
+    return true;
+}
