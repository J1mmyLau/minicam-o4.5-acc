+static bool talker_rollout_host_little_endian() {
+    const uint16_t value = 1;
+    return *(const uint8_t *) &value == 1;
+}
+
+static void talker_rollout_append_u16(std::vector<uint8_t> & out, uint16_t value) {
+    out.push_back((uint8_t) value);
+    out.push_back((uint8_t) (value >> 8));
+}
+
+static void talker_rollout_append_u32(std::vector<uint8_t> & out, uint32_t value) {
+    for (int shift = 0; shift < 32; shift += 8) {
+        out.push_back((uint8_t) (value >> shift));
+    }
+}
+
+static void talker_rollout_append_u64(std::vector<uint8_t> & out, uint64_t value) {
+    for (int shift = 0; shift < 64; shift += 8) {
+        out.push_back((uint8_t) (value >> shift));
+    }
+}
+
+static void talker_rollout_append_i32(std::vector<uint8_t> & out, int32_t value) {
+    talker_rollout_append_u32(out, (uint32_t) value);
