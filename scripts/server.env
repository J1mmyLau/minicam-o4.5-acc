# server.env — RTS / 性能链路 server 启动环境（A+C 配方 + TileLang 融合核）
# 用法: 在启动 llama-omni-server 前以 `set -a; source server.env; set +a` 注入
# ⚠ 本文件仅用于性能链路。精度任务（videomme/daily-omni/tts）必须用 config-accuracy.env，
#   两套 env 严禁混用（GM3M9G：perf env 泄漏进精度 CLI 会在 30k-token prefill 上污染 logits）。

# --- A+C 性能杠杆 ---
OMNI_DUPLEX_MAX_SLICE=0          # 杠杆A: 仅 overview 64 vision token/帧（128→64）
OMNI_TTS_FIRST_CHUNK_STEP=10     # 杠杆C: 首 TTS chunk 10 token（默认5, chunk边界税摊薄）

# --- 稳定性基线（Config D 继承）---
OMNI_CANN_FA_MAX_UBATCH=32
OMNI_T2W_DEVICE=cann-flow-only
OMNI_VOC_DEVICE=gpu:0
OMNI_T2W_PIPELINE_OVERLAP=1
GGML_CANN_WEIGHT_NZ=off

# --- TileLang 融合核 / host 税削减（perf/tilelang-bridge 分支主体）---
OMNI_TL_QKR=1                    # QK-norm+RoPE 整段融合核（decode 主增益）
OMNI_TL_NORM=1                   # RMSNorm 行融合核（3 位点/层×36）
OMNI_TL_TTS=1                    # TTS token 生成链融合核
OMNI_TL_CONV=1                   # vocoder conv1d TileLang im2col（t2w −21%）
OMNI_VPM_PAR=1                   # VPM 视觉图并行调度
OMNI_VPM_PATCHMM=1               # VPM patch mm 融合
GGML_CANN_OPERATOR_FUSION=1
GGML_CANN_ACL_GRAPH=on
GGML_CANN_ACL_GRAPH_MAX_NODES=4000

# --- RTS 专用 NFE2（launch-only，不改 config 默认 NFE5）---
# RTS 启动命令需额外带:
#   OMNI_T2W_N_TIMESTEPS=2
#   OMNI_T2W_PROMPT_CACHE=/workspace/models/token2wav-rts-nfe2/prompt_cache.gguf
# （token2wav 桥：NFE2 图缓存资产位级 parity 已验证）

# --- 设备 ---
ASCEND_RT_VISIBLE_DEVICES=1
