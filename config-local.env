# MiniCPM-o 评测套件配置（shell KEY=VALUE）
# 优先级：命令行 > 环境变量 > 本文件。详见 evaluation/README.md

# --- 1. 模型权重 ---
# GGUF 根目录（含 LLM 与 vision/ audio/ tts/ token2wav-gguf/）
# https://huggingface.co/openbmb/MiniCPM-o-4_5-gguf
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf

# 精度任务 LLM
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
# 速度任务 LLM
RTS_MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
# TTS 子模型（可留空，由 C++ 从 MODEL_DIR/tts 查找）
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# --- 2. 路径 ---
# 仓库根（默认上级目录）
LLAMACPP_ROOT=$(cd "${EVAL_SUITE_ROOT}/.." && pwd)
# 精度 CLI 所在目录（llama-omni-eval-cli / daily-cli / tts-eval）
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build/bin
# RTS server 二进制（留空则自动搜索）
OMNI_SERVER_BIN=
ASCEND_ENV=/usr/local/Ascend/cann/set_env.sh
# 四任务共用采样种子（可环境变量覆盖）
EVAL_SEED=${EVAL_SEED:-42}

# --- 3. 算力卡 ---
# Ascend: ASCEND_RT_VISIBLE_DEVICES；NVIDIA: CUDA_VISIBLE_DEVICES
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=1
# worker 数；留空=用满 DEVICE_IDS
DEVICE_COUNT=
# RTS 用卡；留空=按空闲显存自动选
RTS_DEVICE_ID=1

# --- 4. smoke 条数（0=全量）---
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120

# --- 5. 数据集 ---
ASSETS_DIR=/workspace/llama.cpp-omni-bench-huawei/evaluation/appendix

PARQUET_PATH=${ASSETS_DIR}/videomme/test-00000-of-00001.parquet
VIDEO_DATA_DIR=${ASSETS_DIR}/videomme/data

DATASET_DIR=${ASSETS_DIR}/daily-omni
ANNOTATION_PATH=${DATASET_DIR}/daily_omni.jsonl

EVAL_DATA_PATH=${ASSETS_DIR}/seedtts_testset_zh/zh
EVAL_META_PATH=${EVAL_DATA_PATH}/meta.lst

# RTS 视频（多个用空格分隔）
RTS_VIDEO=${EVAL_SUITE_ROOT}/judge-final/assets/video/omni_duplex1.mp4

# --- 6. TTS 打分模型 ---
# ⚠️ wavlm_large_finetune.pth 不在 bench-huawei appendix（SIM 会被静默跳过），用 seed-tts-eval 侧资产
SPEAKER_CKPT=/workspace/shared_assets/datasets/CowboyZ/seed-tts-eval/wavlm_large_finetune.pth
PARAFORMER_MODEL=${ASSETS_DIR}/paraformer-zh
S3PRL_REPO=${ASSETS_DIR}/s3prl
# 离线环境必须预先放好，否则 SIM 可能长时间无结果
WAVLM_LARGE_PT=${ASSETS_DIR}/wavlm_large.pt
ONNX_MODEL_DIR=${ASSETS_DIR}/Step-Audio-2-mini/token2wav

# --- 7. Python ---
# 建议填 venv 绝对路径，例如 /path/to/.venv-eval/bin/python
EVAL_PYTHON=/workspace/llama.cpp-omni-bench-huawei/.venv-eval/bin/python
RTS_PYTHON=/workspace/llama.cpp-omni-bench-huawei/.venv-eval/bin/python

# --- 8. 推理参数 ---
CTX_SIZE=40960
# Ascend 上请保持 off（F16 精度 / vision encode 稳定性）
GGML_CANN_WEIGHT_NZ=off

CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
WER_DEVICE=cpu
SIM_DEVICE=cpu
# --- 跑通经验 (config_d_official.env): FA NaN workaround + T2W pipeline ---
OMNI_CANN_FA_MAX_UBATCH=32
OMNI_T2W_DEVICE=cann-flow-only
OMNI_VOC_DEVICE=gpu:0
OMNI_T2W_PIPELINE_OVERLAP=1
# --- [F6 RTF Phase 1 固化] A+C 配方 (4-run 0.4829±0.016, 基线 0.6102, −21%) ---
# ⚠️ GM3M9G: 这两个杠杆只作用于 server/RTS 链路。评测 harness 经 run_eval.py base_env()
# 把全量 env 泄漏给精度 CLI，在 videomme 64帧/29.9k-token 长上下文上系统性劣化
# 输出（Q001-1 复现: 全 env→乱码, 关闭→连贯英文），Video-MME 8% vs 基线 69.8%。
# 修复：精度任务里显式关掉（run_eval.py 各精度任务 env 已带 =0 覆盖）。
OMNI_DUPLEX_MAX_SLICE=0
OMNI_TTS_FIRST_CHUNK_STEP=10
# --- [GM3M9G 修复] 精度任务泄漏的 perf env 全量显式关闭 ---
# （eval CLI 不吃这些：TL kernel/AI 算子融合/图捕获在 30k-token prefill 上污染 logits）
# perf 主配方（RTS/性能链路）。⚠ 精度任务不要用本文件——GM3M9G 隔离版在
# submission/config/config-accuracy.env（OMNI_TL_*=0 / ACL_GRAPH=off 全量关闭）。
# 此处曾被误置 0（GM3M9G 修复期），导致 RTS 复测 tts 0.14→0.25 / RTF 0.49→0.62，
# 已恢复 4-run (0.4829) 时的 ON 状态。
OMNI_TL_QKR=1
OMNI_TL_NORM=1
OMNI_TL_TTS=1
OMNI_TL_CONV=1
OMNI_VPM_PAR=1
OMNI_VPM_PATCHMM=1
GGML_CANN_OPERATOR_FUSION=1
GGML_CANN_ACL_GRAPH=on
GGML_CANN_WEIGHT_NZ=off
# NFE5 matches the shipped prompt_cache.gguf (estimator slots 80=5×16). NFE=3 breaks
# init_from_host_caches shape identity → Token2Wav init fails → tts-eval null-deref SIGSEGV.
# NFE2 is RTS-only via the launch-env override documented at the bottom of this file.
# NOTE: do NOT set OMNI_T2W_N_TIMESTEPS here — run_eval.sh sources this file with `set -a`
# AFTER inheriting the launch env, so a value here clobbers the RTS launch override
# (NFE5 + nfe2 prompt cache → Token2Wav worker init FAILED → CPU fallback → 0 wav events).
# The C++ default is already 5; leave unset so `env OMNI_T2W_N_TIMESTEPS=2 ...` wins.

# --- [F6 RTF Phase 1 固化] A+C 配方 (4-run 0.4829±0.016, 基线 0.6102, −21%) ---
# 杠杆A: 仅 overview 64 vision token/帧 (128→64, encode+prefill −0.093)
OMNI_DUPLEX_MAX_SLICE=0
# 杠杆C: 首 TTS chunk 10 token (默认 5; chunk 边界税摊薄, decode −0.035)
OMNI_TTS_FIRST_CHUNK_STEP=10

# Genuine NFE2 is RTS-only; pass both variables only to an RTS launch:
# env OMNI_T2W_N_TIMESTEPS=2 OMNI_T2W_PROMPT_CACHE=/workspace/models/token2wav-rts-nfe2/prompt_cache.gguf EVAL_CONFIG="$PWD/config-local.env" ./evaluation/run_eval.sh rts
