# =============================================================================
# EXTERNAL CONFIG — Config D official runtime (candidate-owned, NOT under evaluation/)
# -----------------------------------------------------------------------------
# This file is sourced via `EVAL_CONFIG` (the organizer-provided hook in
# run_all.sh: `CONFIG="${EVAL_CONFIG:-$SUITE_ROOT/config.env}"`). It mirrors the
# pristine evaluation/config.env (c9785cc) byte-structure and overrides ONLY the
# environment-specific values that a candidate MUST set locally:
#
#   1. MODEL_DIR        -> actual GGUF root
#   2. SPEAKER_CKPT     -> actual Seed-TTS finetuned speaker ckpt
#   3. EVAL_PYTHON / RTS_PYTHON -> offline venv interpreter
#   4. DEVICE_IDS       -> 2 physical NPUs (0,1)
#   5. Section 9        -> Config D runtime (CANN flow + CANN vocoder + overlap)
#
# evaluation/config.env is UNMODIFIED. All evaluator logic paths are pristine.
# =============================================================================

# --- 1. 模型权重 ---
MODEL_DIR=/workspace/models/MiniCPM-o-4_5-gguf

# 精度任务 LLM
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
# 速度任务 LLM
RTS_MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
# TTS 子模型（可留空，由 C++ 从 MODEL_DIR/tts 查找）
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# --- 2. 路径 ---
LLAMACPP_ROOT=$(cd "${EVAL_SUITE_ROOT}/.." && pwd)
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build/bin
OMNI_SERVER_BIN=
ASCEND_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
EVAL_SEED=${EVAL_SEED:-42}

# --- 3. 算力卡 ---
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0,1
DEVICE_COUNT=
RTS_DEVICE_ID=

# --- 4. smoke 条数（0=全量）---
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120

# --- 5. 数据集 ---
ASSETS_DIR=${EVAL_SUITE_ROOT}/appendix

PARQUET_PATH=${ASSETS_DIR}/videomme/test-00000-of-00001.parquet
VIDEO_DATA_DIR=${ASSETS_DIR}/videomme/data

DATASET_DIR=${ASSETS_DIR}/daily-omni
ANNOTATION_PATH=${DATASET_DIR}/daily_omni.jsonl

EVAL_DATA_PATH=${ASSETS_DIR}/seedtts_testset_zh/zh
EVAL_META_PATH=${EVAL_DATA_PATH}/meta.lst

RTS_VIDEO=${EVAL_SUITE_ROOT}/judge-final/assets/video/omni_duplex1.mp4

# --- 6. TTS 打分模型 ---
PARAFORMER_MODEL=${ASSETS_DIR}/paraformer-zh
SPEAKER_CKPT=/workspace/shared_assets/datasets/CowboyZ/seed-tts-eval/wavlm_large_finetune.pth
S3PRL_REPO=${ASSETS_DIR}/s3prl
WAVLM_LARGE_PT=${ASSETS_DIR}/wavlm_large.pt
ONNX_MODEL_DIR=${ASSETS_DIR}/Step-Audio-2-mini/token2wav

# --- 7. Python ---
EVAL_PYTHON=${EVAL_SUITE_ROOT}/../.venv-eval/bin/python3
RTS_PYTHON=${EVAL_SUITE_ROOT}/../.venv-eval/bin/python3

# --- 8. 推理参数 ---
CTX_SIZE=40960
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
WER_DEVICE=cpu
SIM_DEVICE=cpu

# --- 9. Config D runtime (candidate) ---
# CANN flow-matching + CANN vocoder + Flow∥Vocoder pipeline overlap.
# Injected externally; no evaluator file is modified.
OMNI_T2W_DEVICE=cann-flow-only
OMNI_VOC_DEVICE=gpu:0
OMNI_T2W_PIPELINE_OVERLAP=1
OMNI_CANN_FA_MAX_UBATCH=16
